{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "visa-research-agent",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "visa_research_agent.api.app:create_app",
        "--factory",
        "--port",
        "8099"
      ],
      "port": 8099
    },
    {
      "name": "visa-research-agent-signin",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "visa_research_agent.api.app:create_app",
        "--factory",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "visa-research-agent-open",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "REQUIRE_SIGN_IN=false",
        ".venv/bin/python",
        "-m",
        "uvicorn",
        "visa_research_agent.api.app:create_app",
        "--factory",
        "--port",
        "8098"
      ],
      "port": 8098
    }
  ]
}
