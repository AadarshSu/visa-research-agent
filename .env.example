# Secrets and machine-local tuning only.
#
# Source mode, extraction mode and the retrieval freshness policy are NOT set here. They are
# reviewable policy and live in src/visa_research_agent/config/runtime.yaml.

# OpenAI extraction is optional. Keep secrets only in .env, never in this template.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Source discovery needs a search key (Brave Search API). Only the `visa-discover` command uses
# it; generating a visa plan never searches the web.
SEARCH_API_KEY=

CACHE_DIRECTORY=var/cache

# Live retrieval tuning.
SOURCE_FETCH_TIMEOUT_SECONDS=20
SOURCE_FETCH_CONCURRENCY=4
MAXIMUM_SOURCE_CHARACTERS=50000
MINIMUM_SOURCE_CHARACTERS=400
